#.
#Maximum size of monitor MultiBlock
# Default: 9
# Range: > 1
monitorMaxSize = 9
#.
#The firing delay used in leading calculation. Higher values may prove useful in laggy environments
# Default: 0
# Range: 0 ~ 1000
firingDelay = 0
#.
#Increases the max Rotational speed of phys bearings controlled by Pitch/Yaw controllers
# Default: 25.0
# Range: 2.0 ~ 25.0
controllerPhysbearingMaxSpeed = 25.0
#.
#The range at which the binocular can acquire a target
# Default: 512
# Range: 1 ~ 1000
binocularRange = 512
#.
#how fast a target must be moving before looser firing conditions are applied (value is in m/s)
# Default: 3.0
# Range: 0.0 ~ 3.4028234663852886E38
targetLoosenThreshold = 3.0
#.
#increases the tolerance used to determine if cannons are pointing at the target (degrees)
# Default: 15
# Range: 0 ~ 180
targetLoosenAmount = 15
#.
#Use the new simulated targeting computer as the primary CBC auto aiming path
useNewTargetingComputer = true
#.
#Force CBC auto aiming to use the legacy lead solver instead of the new targeting computer
forceLegacyCannonLeadSolver = false
#.
#Minimum horizontal target speed in blocks per tick for sprint-jump movement to count as erratic
# Default: 0.1599999964237213
# Range: 0.0 ~ 3.4028234663852886E38
sprintJumpMinHorizontalSpeed = 0.1599999964237213
#.
#Minimum upward target speed in blocks per tick for sprint-jump movement to count as erratic
# Default: 0.11999999731779099
# Range: 0.0 ~ 3.4028234663852886E38
sprintJumpVerticalSpeedThreshold = 0.11999999731779099
#.
#Required stable aim ticks when target motion is erratic
# Default: 1
# Range: 0 ~ 20
erraticTargetStableTicks = 1
#.
#Extra target prediction ticks used to compensate for radar and cannon tracking latency
# Default: 3
# Range: 0 ~ 20
targetTrackingLeadTicks = 3

#.
#Configs for radar bearing and radar stats
[radarStatsConfig]
	#.
	#Maximum range of a Radar Contraption in blocks
	# Default: 2048
	# Range: > 1
	maxRadarRange = 1000
	#.
	#Maximum vertical scan range of a radar in blocks
	# Default: 32
	# Range: > 1
	radarYScanRange = 400
	#.
	#Base range of a radar receiver in blocks
	# Default: 1
	# Range: > 1
	radarBaseRange = 20
	#.
	#Range increase per dish block in blocks
	# Default: 32
	# Range: > 1
	dishRangeIncrease = 10
	#.
	#increases the range of the plane radar(in blocks)
	# Default: 256
	# Range: 1 ~ 1000
	planeRadarRange = 250
	#.
	#If true, radar bearings will rotate slower the more dishes are connected to them
	gearRadarBearingSpeed = true
	#.
	#Field of view of a radar in degrees
	# Default: 90
	# Range: 1 ~ 360
	radarFOV = 90

#.
#Configs for the guided fuze
[guidedFuzeConfig]
	#.
	#The size of the cone the guided fuze can track targets from. Values are in degrees and are bi-directional (180 = full circle)
	# Default: 180.0
	# Range: 1.0 ~ 180.0
	guidedFuzeMaxSeekDegrees = 180.0
	#.
	#The maximum number of degrees per tick the guided fuze can correct its course
	# Default: 3.0
	# Range: 1.0 ~ 3.4028234663852886E38
	guidedFuzeMaxDegreesPerTick = 3.0
	#.
	#Determines if the guided fuze can seek its target before it has began to fall
	guidedFuzeSeekBeforeApex = false

#.
#Controller GUI collision snapshot limits
[controllerCollisionViewConfig]
	#.
	#Maximum half-span of a controller collision view in blocks
	# Default: 64
	# Range: 5 ~ 256
	maxHalfSpan = 64
	#.
	#Maximum block positions inspected for one controller collision snapshot
	# Default: 100000
	# Range: 500 ~ 1000000
	maxScannedBlocks = 100000
	#.
	#Maximum collision boxes returned in one controller collision snapshot
	# Default: 16384
	# Range: 128 ~ 16384
	maxCollisionBoxes = 16384

#.
#Firework chaff lock-breaking behavior
[chaffConfig]
	#.
	#Allow fireworks to temporarily break radar locks
	enabled = true
	#.
	#Maximum firework detonation distance from a selected target in blocks
	# Default: 8.0
	# Range: 0.0 ~ 64.0
	radius = 8.0
	#.
	#Quiet time before nearby firework chaff starts a new probability volley
	# Default: 40
	# Range: 1 ~ 1200
	volleyWindowTicks = 40
	#.
	#Lock-break chance for one small firework star
	# Default: 0.20000000298023224
	# Range: 0.0 ~ 1.0
	minChance = 0.20000000298023224
	#.
	#Lock-break chance for a maximum-strength firework
	# Default: 0.6000000238418579
	# Range: 0.0 ~ 1.0
	maxSingleChance = 0.6000000238418579
	#.
	#Absolute combined lock-break chance cap for one firework volley
	# Default: 0.75
	# Range: 0.0 ~ 1.0
	maxVolleyChance = 0.75
	#.
	#Lock-break duration for one small firework star
	# Default: 10
	# Range: 1 ~ 1200
	minDurationTicks = 10
	#.
	#Maximum lock-break duration for one firework (3.5 seconds by default)
	# Default: 70
	# Range: 1 ~ 1200
	maxDurationTicks = 70
	#.
	#Reduced-success window after a chaff effect expires (5 seconds by default)
	# Default: 100
	# Range: 0 ~ 1200
	resistanceTicks = 100
	#.
	#Chance multiplier while post-chaff resistance is active
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	resistanceChanceMultiplier = 0.5
	#.
	#Permanent lock-break chance added by each successful chaff roll
	# Default: 0.019999999552965164
	# Range: 0.0 ~ 1.0
	permanentBreakChancePerSuccess = 0.019999999552965164

#.
#Configs for Sable radar monitor silhouettes
[sableSilhouetteConfig]
	#.
	#Maximum loaded Sable sublevel blocks inspected while building one radar silhouette
	# Default: 20000
	# Range: > 1
	sableSilhouetteMaxScannedBlocks = 20000
	#.
	#Maximum collision boxes stored in one Sable radar silhouette
	# Default: 12000
	# Range: > 1
	sableSilhouetteMaxCollisionBoxes = 12000
	#.
	#Delay after Sable sublevel block changes before rebuilding a silhouette
	# Default: 40
	# Range: > 1
	sableSilhouetteRebuildDebounceTicks = 40
	#.
	#Cooldown before retrying a failed or too-large Sable silhouette scan
	# Default: 200
	# Range: > 1
	sableSilhouetteFailureCooldownTicks = 200
	#.
	#Conservative refresh interval for visible Sable silhouettes
	# Default: 1200
	# Range: > 20
	sableSilhouetteRefreshTicks = 1200
	#.
	#Use a simple local bounding-box silhouette when detailed scanning is unavailable
	sableSilhouetteUseFallbackBox = true
	#.
	#Log Sable silhouette builds, failures, and revision changes
	sableSilhouetteDebugLogging = false

#.
#Block occlusion behavior for native radars
[radarOcclusionConfig]
	#.
	#Allow solid blocks to obstruct native radar signals
	enabled = true
	#.
	#Maximum number of solid blocks a ground radar signal can pass through
	# Default: 16
	# Range: > 0
	groundRadarMaxSolidBlocks = 16
	#.
	#Maximum number of solid blocks a sky or plane radar signal can pass through
	# Default: 8
	# Range: > 0
	skyPlaneRadarMaxSolidBlocks = 8

#.
#Configs for sky radar
[skyRadarStats]
	#.
	#Maximum horizontal range of a sky radar in blocks
	# Default: 4096
	# Range: > 1
	maxSkyRadarRange = 4096
	#.
	#Field of view of a sky radar in degrees
	# Default: 90
	# Range: 1 ~ 360
	skyRadarFOV = 90
	#.
	#The minimum Y level for a sky radar to function
	# Default: 85
	# Range: -64 ~ 256
	skyRadarMinY = 85
	#.
	#Range increase per dish block in blocks for the sky radar
	# Default: 64
	# Range: > 1
	skyRadarDishRangeIncrease = 64
